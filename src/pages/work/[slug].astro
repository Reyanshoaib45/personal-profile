---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import reyan from '../../assets/reyan.png';
import { site } from '../../config';

export async function getStaticPaths() {
  const entries = await getCollection('caseStudies', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;

const toc = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));
const url = `${site.url}/work/${entry.id}/`;
const published = data.publishedAt.toISOString().slice(0, 10);
const updated = data.updatedAt?.toISOString().slice(0, 10);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: data.title,
      description: data.description,
      datePublished: published,
      dateModified: updated ?? published,
      author: { '@type': 'Person', name: site.name, url: site.url },
      publisher: { '@type': 'Person', name: site.name, url: site.url },
      mainEntityOfPage: url,
      about: data.sector,
      keywords: data.stack.join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
        { '@type': 'ListItem', position: 2, name: 'Work', item: `${site.url}/#work` },
        { '@type': 'ListItem', position: 3, name: data.title, item: url },
      ],
    },
  ],
};
---

<Layout title={`${data.title} — ${site.name}`} description={data.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <Navbar base="/" />

  <main id="main" class="pb-24">
    <article>
      <!-- Header ------------------------------------------------------- -->
      <header class="border-b border-line/70">
        <div class="mx-auto max-w-6xl px-6 pt-10 pb-12 sm:pt-14">
          <nav aria-label="Breadcrumb" class="flex items-center gap-2 font-mono text-[11px] tracking-wide uppercase">
            <a href="/" class="text-muted transition hover:text-fg">Home</a>
            <span class="text-muted/40" aria-hidden="true">/</span>
            <a href="/#work" class="text-muted transition hover:text-fg">Work</a>
            <span class="text-muted/40" aria-hidden="true">/</span>
            <span class="text-accent" aria-current="page">{data.client}</span>
          </nav>

          <div class="mt-8 flex flex-wrap items-center gap-2">
            <span
              class="inline-flex items-center gap-1.5 rounded-full border border-accent/25 bg-accent/8 px-2.5 py-1 font-mono text-[10px] tracking-wide text-accent uppercase"
            >
              <span class="size-1 rounded-full bg-accent" aria-hidden="true"></span>
              {data.status}
            </span>
            <span class="font-mono text-[10px] tracking-wide text-muted uppercase">
              {data.client} · {data.period}
            </span>
          </div>

          <h1 class="mt-5 max-w-4xl text-3xl leading-[1.12] font-semibold sm:text-4xl lg:text-[2.9rem]">
            {data.title}
          </h1>

          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{data.deck}</p>

          <dl class="mt-9 grid gap-x-8 gap-y-5 border-t border-line pt-6 sm:grid-cols-3">
            <div>
              <dt class="font-mono text-[10px] tracking-wide text-muted/70 uppercase">Role</dt>
              <dd class="mt-1.5 text-sm text-fg">{data.role}</dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] tracking-wide text-muted/70 uppercase">Sector</dt>
              <dd class="mt-1.5 text-sm text-fg">{data.sector}</dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] tracking-wide text-muted/70 uppercase">Published</dt>
              <dd class="mt-1.5 text-sm text-fg">
                <time datetime={published}>
                  {data.publishedAt.toLocaleDateString('en-GB', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
              </dd>
            </div>
          </dl>

          {
            data.stack.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-2" aria-label="Technology used">
                {data.stack.map((tech) => (
                  <li class="rounded-md border border-line px-2 py-1 font-mono text-[10px] text-muted">
                    {tech}
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </header>

      <!-- Metrics ------------------------------------------------------- -->
      <div class="border-b border-line/70 bg-panel/40">
        <div class="mx-auto max-w-6xl px-6 py-8">
          <dl class="grid grid-cols-2 gap-x-6 gap-y-7 sm:grid-cols-4">
            {
              data.metrics.map((metric) => (
                <div>
                  <dt class="sr-only">{metric.label}</dt>
                  <dd>
                    <span class="block text-2xl font-semibold tracking-tight text-accent sm:text-3xl">
                      {metric.value}
                    </span>
                    <span class="mt-1 block text-xs leading-snug text-muted">{metric.label}</span>
                    {metric.note && (
                      <span class="mt-0.5 block font-mono text-[10px] text-muted/60">
                        {metric.note}
                      </span>
                    )}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <!-- Body ---------------------------------------------------------- -->
      <div class="mx-auto max-w-6xl px-6">
        {
          data.cover && (
            <Image
              src={data.cover}
              alt={data.coverAlt ?? ''}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1152px) 1104px, 100vw"
              class="mt-12 w-full rounded-xl border border-line"
            />
          )
        }

        <div class="mt-12 grid gap-14 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-16">
          <div class="min-w-0">
            <div class="article-body">
              <Content />
            </div>

            <!-- Author + CTA -------------------------------------------- -->
            <div class="mt-16 rounded-2xl border border-line bg-panel p-6 sm:p-8">
              <div class="flex items-start gap-4">
                <Image
                  src={reyan}
                  alt={`Portrait of ${site.name}`}
                  width={160}
                  height={160}
                  format="webp"
                  quality={82}
                  loading="lazy"
                  class="size-14 shrink-0 rounded-lg object-cover ring-1 ring-line"
                />
                <div>
                  <p class="text-sm font-semibold">{site.name}</p>
                  <p class="mt-1 text-sm leading-relaxed text-muted">
                    Full-stack engineer building AI agents, automations and internal systems
                    that run in production. Laravel · Vue · MySQL.
                  </p>
                </div>
              </div>

              <div class="mt-7 border-t border-line/70 pt-6">
                <h2 class="text-lg font-semibold tracking-tight">
                  Does your system pay out on trust?
                </h2>
                <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted">
                  If money leaves your business on the basis of a judgement, I can map where
                  it happens and what it would take to make the rules impossible to bypass.
                  Twenty minutes, no pitch deck.
                </p>
                <div class="mt-6 flex flex-col gap-3 sm:flex-row">
                  <a
                    href={site.booking.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-accent-ink transition hover:brightness-95"
                  >
                    {site.booking.label}
                  </a>
                  <a
                    href="/#contact"
                    class="inline-flex items-center justify-center rounded-lg border border-line px-5 py-2.5 text-sm font-semibold text-fg transition hover:border-accent/40 hover:bg-panel-2"
                  >
                    Send a message
                  </a>
                </div>
              </div>
            </div>

            <p class="mt-8">
              <a
                href="/#work"
                class="font-mono text-[11px] tracking-wide text-muted uppercase transition hover:text-accent"
              >
                ← Back to all work
              </a>
            </p>
          </div>

          <!-- Table of contents ----------------------------------------- -->
          {
            toc.length > 0 && (
              <aside class="hidden lg:block" aria-label="On this page">
                <div class="sticky top-24">
                  <p class="font-mono text-[10px] tracking-wide text-muted/70 uppercase">
                    On this page
                  </p>
                  <nav class="mt-3 border-l border-line">
                    <ol class="space-y-2.5">
                      {toc.map((item) => (
                        <li>
                          <a
                            href={`#${item.slug}`}
                            class="-ml-px block border-l border-transparent pl-4 text-[13px] leading-snug text-muted transition hover:border-accent hover:text-fg"
                          >
                            {item.text}
                          </a>
                        </li>
                      ))}
                    </ol>
                  </nav>
                </div>
              </aside>
            )
          }
        </div>
      </div>
    </article>
  </main>
</Layout>
