---
import { Image } from 'astro:assets';
import reyan from '../assets/reyan.png';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import CaseStudies from '../components/CaseStudies.astro';
import WhatsAppDemoSection from '../components/WhatsAppDemoSection.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config';
---

<Layout>
  <Navbar />

  <main id="main">
    <Hero />
    <CaseStudies />
    <WhatsAppDemoSection />
    <Services />
    <Process />
    <FAQ />

    <!-- Closing CTA ------------------------------------------------------- -->
    <section id="contact" class="border-t border-line/70 py-20 sm:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div
          class="reveal relative overflow-hidden rounded-2xl border border-line bg-panel p-5 sm:p-10 lg:p-12"
        >
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -top-24 -right-16 size-72 rounded-full bg-accent/8 blur-3xl"
          >
          </div>

          <div class="relative grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start lg:gap-12">
            <div>
              <p class="font-mono text-[11px] tracking-wide text-accent uppercase">
                Next step
              </p>
              <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">
                What's the manual thing you want gone?
              </h2>
              <p class="mt-4 text-base leading-relaxed text-muted">
                Twenty minutes, no pitch deck. Tell me how the work currently gets done and
                I'll tell you what it would take to automate — including whether it's worth
                automating at all.
              </p>

              <div class="mt-7">
                <a
                  href={site.booking.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center rounded-lg border border-accent/30 bg-accent/8 px-5 py-3 text-sm font-semibold text-accent transition hover:bg-accent/12"
                >
                  Or book the 20-min call directly
                </a>
              </div>

              <div class="mt-8 flex items-center gap-4 rounded-xl border border-line bg-ink p-4">
                <Image
                  src={reyan}
                  alt={`Portrait of ${site.name}`}
                  width={160}
                  height={160}
                  format="webp"
                  quality={82}
                  loading="eager"
                  class="size-16 shrink-0 rounded-lg object-cover ring-1 ring-line"
                />
                <div>
                  <p class="text-sm font-semibold">{site.name}</p>
                  <p class="mt-1 text-xs leading-relaxed text-muted">
                    Full-stack engineer. Laravel · Vue · MySQL. Six months embedded with a US
                    product team.
                  </p>
                  <a
                    href={site.resume}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-2 inline-block font-mono text-[10px] tracking-wide text-accent uppercase hover:brightness-110"
                  >
                    Résumé ↗
                  </a>
                </div>
              </div>

              <p class="mt-6 font-mono text-[11px] tracking-wide text-muted/80 uppercase">
                Pakistan · reply within 1 business day
              </p>
            </div>

            <ContactForm />
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
