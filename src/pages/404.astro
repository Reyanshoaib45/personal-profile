---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { site } from '../config';
---

<Layout
  title={`Page not found — ${site.name}`}
  description="That page doesn't exist. Head back to the portfolio, the case studies, or send a message."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
  </Fragment>

  <Navbar base="/" />

  <main id="main" class="mx-auto flex max-w-6xl flex-col justify-center px-6 py-24 sm:py-32">
    <p class="font-mono text-[11px] tracking-wide text-accent uppercase">Error 404</p>

    <h1 class="mt-4 max-w-2xl text-4xl leading-[1.1] font-semibold sm:text-5xl">
      This page doesn't exist.
    </h1>

    <p class="mt-5 max-w-xl text-base leading-relaxed text-muted">
      Either the link is old or I moved something. The work is still where it was — try one
      of these.
    </p>

    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-accent-ink transition hover:brightness-95"
      >
        Back to the homepage
      </a>
      <a
        href="/#work"
        class="inline-flex items-center justify-center rounded-lg border border-line bg-panel px-5 py-3 text-sm font-semibold text-fg transition hover:border-accent/40 hover:bg-panel-2"
      >
        See the case studies
      </a>
      <a
        href={`mailto:${site.email}`}
        class="inline-flex items-center justify-center px-2 py-3 text-sm font-medium text-muted transition hover:text-fg"
      >
        Email me instead
      </a>
    </div>
  </main>
</Layout>
