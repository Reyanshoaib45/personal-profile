---
import '../styles/global.css';
import { site, offers, showPrices } from '../config';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph object type — `article` on case-study pages. */
  ogType?: 'website' | 'article' | 'profile';
}

const {
  title = `${site.name} — AI systems that delete manual work`,
  description = 'Reyan Shoaib — full-stack engineer building AI agents, WhatsApp automations and Laravel/Vue systems that run in production.',
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogTitle = title;
const year = new Date().getFullYear();

/* -------------------------------------------------------------------------- */
/* SEO constants                                                              */
/* -------------------------------------------------------------------------- */

const ogImage = new URL('/images/og.png', site.url).href;
/** Set PUBLIC_GOOGLE_SITE_VERIFICATION to the token Search Console gives you. */
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const ogImageAlt = `${site.name} — full-stack engineer for AI automation, WhatsApp agents and Laravel systems`;

/**
 * Search terms this site is built to rank for: personal branding first (people
 * search names), commercial intent second. The <meta name="keywords"> tag is
 * ignored by Google and Bing, so the same phrases are carried by the title,
 * description and JSON-LD `knowsAbout` / service names — that is what ranks.
 */
const keywords = [
  // Personal brand — cheap to own, and what a referral actually types.
  'Reyan Shoaib',
  'Reyan Shoaib Developer',
  'Reyan Shoaib Software Engineer',
  'Reyan Shoaib Full Stack Engineer',
  'M Reyan Shoaib',
  'Reyan Shoaib portfolio',
  // Commercial intent, phrased the way buyers search (Upwork 2026: "AI
  // automation engineer" / "AI workflow automation" are the fastest-growing
  // AI searches; WhatsApp + Laravel is a narrow, defensible niche).
  'AI Automation Engineer',
  'AI workflow automation',
  'AI automation expert',
  'AI integration developer',
  'Laravel AI Integration Specialist',
  'WhatsApp AI Agent Developer',
  'Custom WhatsApp AI Agent',
  'WhatsApp Business API integration',
  'WhatsApp automation for business',
  'Laravel WhatsApp Cloud API developer',
  'Laravel Vue developer',
  'custom internal business system developer',
  // Location modifier — low competition, real local intent.
  'AI automation engineer Pakistan',
  'hire Laravel developer Pakistan',
];

const ids = {
  person: `${site.url}/#person`,
  service: `${site.url}/#service`,
  website: `${site.url}/#website`,
  webpage: `${canonical}#webpage`,
  image: `${site.url}/#og-image`,
};

const jobTitle = 'Full-Stack Software Engineer';

const knowsAbout = [
  'Full-stack software engineering',
  'AI automation',
  'AI workflow automation',
  'AI agent development',
  'AI integration',
  'WhatsApp automation',
  'WhatsApp Business API',
  'WhatsApp Cloud API',
  'Laravel',
  'Vue.js',
  'MySQL',
  'LLM integration',
  'LLM tool calling',
  'Backend architecture',
  'Internal business systems',
];

const areaServed = ['United States', 'European Union', 'Pakistan'];

/** Service offers from src/config.ts. Prices only when `showPrices` is on. */
const serviceOffers = offers.map((offer) => ({
  '@type': 'Offer',
  ...(showPrices
    ? { priceCurrency: 'USD', price: Number(offer.price.replace(/[^0-9]/g, '')) }
    : {}),
  url: `${site.url}/#services`,
  itemOffered: {
    '@type': 'Service',
    name: offer.name,
    description: offer.outcome,
    serviceType: offer.name,
    provider: { '@id': ids.service },
    areaServed,
  },
}));

/* -------------------------------------------------------------------------- */
/* Structured data — one @graph, every node cross-referenced by @id           */
/* -------------------------------------------------------------------------- */

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': ids.person,
      name: site.name,
      alternateName: ['Reyan Shoaib', 'Reyan'],
      jobTitle,
      description:
        'Reyan Shoaib is a full-stack software engineer specialising in AI-native systems, WhatsApp automation bots and Laravel/Vue web products.',
      url: `${site.url}/`,
      image: { '@id': ids.image },
      email: `mailto:${site.email}`,
      telephone: `+${site.phoneRaw}`,
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'PK',
      },
      sameAs: [site.github, site.linkedin],
      knowsAbout,
      hasOccupation: {
        '@type': 'Occupation',
        name: jobTitle,
        occupationalCategory: '15-1252.00',
        skills: knowsAbout.join(', '),
      },
      worksFor: { '@id': ids.service },
    },
    {
      '@type': 'ProfessionalService',
      '@id': ids.service,
      name: 'Reyan Shoaib — AI Automation & Software Engineering',
      alternateName: 'Reyan Shoaib Technology Service',
      description:
        'Freelance engineering practice building AI agents, custom WhatsApp AI bots and Laravel/Vue internal systems for companies in the US, EU and Pakistan.',
      url: `${site.url}/`,
      image: { '@id': ids.image },
      telephone: `+${site.phoneRaw}`,
      email: `mailto:${site.email}`,
      priceRange: '$$',
      currenciesAccepted: 'USD',
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'PK',
      },
      founder: { '@id': ids.person },
      provider: { '@id': ids.person },
      areaServed,
      sameAs: [site.github, site.linkedin],
      knowsAbout,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'AI automation and product engineering services',
        itemListElement: serviceOffers,
      },
    },
    {
      '@type': 'WebSite',
      '@id': ids.website,
      url: `${site.url}/`,
      name: site.name,
      inLanguage: 'en',
      publisher: { '@id': ids.person },
    },
    {
      '@type': 'WebPage',
      '@id': ids.webpage,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': ids.website },
      about: [{ '@id': ids.person }, { '@id': ids.service }],
      primaryImageOfPage: { '@id': ids.image },
      inLanguage: 'en',
    },
    {
      '@type': 'ImageObject',
      '@id': ids.image,
      url: ogImage,
      contentUrl: ogImage,
      width: 1200,
      height: 630,
      caption: ogImageAlt,
    },
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Ignored by Google/Bing, kept for other crawlers. The real keyword
         signals live in the title, description and JSON-LD below. -->
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#08090b" />
    <meta name="color-scheme" content="dark" />

    <!-- Open Graph ------------------------------------------------------- -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter / X ------------------------------------------------------ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href={new URL('/sitemap-index.xml', site.url).href} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Marks that JS is available, so scroll-reveal only hides content when it
         can be revealed again. Without JS, every section stays visible. -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <slot name="head" />
  </head>

  <body class="bg-ink text-fg antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-accent-ink"
    >
      Skip to content
    </a>

    <slot />

    <footer class="border-t border-line/80">
      <div class="mx-auto max-w-6xl px-6 py-12">
        <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
          <div class="max-w-sm">
            <div class="flex items-center gap-3">
              <span
                class="grid size-9 place-items-center rounded-lg bg-accent font-mono text-sm font-bold text-accent-ink"
                aria-hidden="true">{site.initials}</span
              >
              <span class="text-sm font-semibold tracking-tight">{site.name}</span>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-muted">
              AI agents, WhatsApp automations and internal systems — built to run in
              production, handed over with the code and the documentation.
            </p>
            <p class="mt-4 font-mono text-xs text-muted">{site.location}</p>
          </div>

          <nav aria-label="Footer" class="grid grid-cols-2 gap-x-10 gap-y-2 text-sm sm:grid-cols-2">
            <a class="text-muted transition hover:text-fg" href="#work">Work</a>
            <a class="text-muted transition hover:text-fg" href="#services">Services</a>
            <a class="text-muted transition hover:text-fg" href="#process">Process</a>
            <a class="text-muted transition hover:text-fg" href="#faq">FAQ</a>
            <a
              class="text-muted transition hover:text-fg"
              href={site.github}
              target="_blank"
              rel="noopener noreferrer">GitHub</a
            >
            <a
              class="text-muted transition hover:text-fg"
              href={site.linkedin}
              target="_blank"
              rel="noopener noreferrer">LinkedIn</a
            >
            <a class="text-muted transition hover:text-fg" href={`mailto:${site.email}`}>Email</a>
            <a class="text-muted transition hover:text-fg" href={site.resume} target="_blank" rel="noopener noreferrer"
              >Résumé</a
            >
          </nav>
        </div>

        <div
          class="mt-10 flex flex-col gap-2 border-t border-line/60 pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
        >
          <p>© {year} {site.name}. All rights reserved.</p>
          <p class="font-mono">Built with Astro · Deployed on Vercel</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Mobile navigation ------------------------------------------------------
      const toggle = document.querySelector('[data-nav-toggle]');
      const menu = document.querySelector('[data-nav-menu]');

      if (toggle && menu) {
        const setOpen = (open) => {
          menu.classList.toggle('hidden', !open);
          toggle.setAttribute('aria-expanded', String(open));
        };

        toggle.addEventListener('click', () => {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });

        menu.addEventListener('click', (event) => {
          if (event.target.closest('a')) setOpen(false);
        });
      }

      // Scroll reveal ----------------------------------------------------------
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealables = document.querySelectorAll('.reveal');

      if (prefersReduced || !('IntersectionObserver' in window)) {
        revealables.forEach((el) => el.classList.add('is-in'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        revealables.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
