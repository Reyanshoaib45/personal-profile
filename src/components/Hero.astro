---
import { site, metrics } from '../config';

const pipeline = [
  { step: '01', title: 'Inbound', detail: 'Customer messages your existing number' },
  { step: '02', title: 'Classify', detail: 'Intent, language and lead score in under 2s' },
  { step: '03', title: 'Act', detail: 'Answer, quote, book a call — or escalate to you' },
  { step: '04', title: 'Log', detail: 'Every turn written to MySQL, auditable' },
];
---

<section id="top" class="relative overflow-hidden">
  <!-- One restrained background element: a soft accent bloom, no particles. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 h-[32rem] w-[52rem] -translate-x-1/2 rounded-full bg-accent/6 blur-3xl"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-6 pt-16 pb-20 sm:pt-24 sm:pb-28">
    <div class="grid items-start gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <!-- Copy ------------------------------------------------------------- -->
      <div>
        <p
          class="inline-flex items-center gap-2 rounded-full border border-line bg-panel px-3 py-1.5 font-mono text-[11px] tracking-wide text-muted uppercase"
        >
          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          Open for 2 builds this quarter
        </p>

        <h1 class="mt-6 text-[clamp(2rem,9.6vw,2.25rem)] leading-[1.06] font-semibold sm:text-5xl sm:leading-[1.05] lg:text-[3.4rem]">
          AI systems for businesses still running on <span class="text-accent">WhatsApp and spreadsheets.</span>
        </h1>

        <p class="mt-6 max-w-xl text-base leading-relaxed text-muted sm:text-lg">
          I'm Reyan — a full-stack engineer. I build AI agents, WhatsApp automations and
          internal systems that run in production: Laravel for the logic, MySQL for the
          truth, Vue for the interface.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={site.booking.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-accent-ink transition hover:brightness-95"
          >
            {site.booking.label}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 11 11 3M11 3H5M11 3v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            href="#work"
            class="inline-flex items-center justify-center rounded-lg border border-line bg-panel px-5 py-3 text-sm font-semibold text-fg transition hover:border-accent/40 hover:bg-panel-2"
          >
            See the 94% case study
          </a>
        </div>

        <p class="mt-4 text-xs text-muted">
          Or message the WhatsApp agent I built — it answers instantly: <a
            href={site.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium whitespace-nowrap text-fg underline decoration-line underline-offset-4 transition hover:decoration-accent"
            >{site.whatsappAgentNumber}</a
          >
        </p>

        <!-- Proof strip ---------------------------------------------------- -->
        <!-- 4-up only when the column is wide enough; 2x2 inside the split hero. -->
        <dl
          class="mt-12 grid grid-cols-2 gap-x-6 gap-y-7 border-t border-line pt-8 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4"
        >
          {
            metrics.map((metric) => (
              <div>
                <dt class="sr-only">{metric.label}</dt>
                <dd>
                  <span class="block text-xl font-semibold tracking-tight sm:text-2xl">
                    {metric.value}
                  </span>
                  <span class="mt-1 block text-xs leading-snug text-muted">{metric.label}</span>
                  <span class="mt-0.5 block font-mono text-[10px] text-muted/70">{metric.sub}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- System diagram --------------------------------------------------- -->
      <div class="lg:pt-10">
        <div class="rounded-2xl border border-line bg-panel p-2">
          <div class="flex items-center justify-between px-3 py-2">
            <div class="flex items-center gap-2">
              <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
              <span class="font-mono text-[11px] tracking-wide text-muted uppercase">
                whatsapp-agent
              </span>
            </div>
            <span class="font-mono text-[11px] text-muted/70">live</span>
          </div>

          <div class="rounded-xl border border-line/70 bg-ink p-5">
            <p class="font-mono text-[11px] tracking-wide text-muted uppercase">
              How a conversation is handled
            </p>

            <ol class="mt-5 space-y-5">
              {
                pipeline.map((node, index) => (
                  <li class="relative flex gap-4">
                    {index < pipeline.length - 1 && (
                      <span
                        class="absolute top-8 left-[15px] h-[calc(100%-8px)] w-px bg-line"
                        aria-hidden="true"
                      />
                    )}
                    <span
                      class="relative z-10 grid size-8 shrink-0 place-items-center rounded-lg border border-line bg-panel font-mono text-[10px] text-muted"
                    >
                      {node.step}
                    </span>
                    <div class="pt-1">
                      <p class="text-sm font-medium">{node.title}</p>
                      <p class="mt-0.5 text-xs leading-relaxed text-muted">{node.detail}</p>
                    </div>
                  </li>
                ))
              }
            </ol>

            <div class="mt-6 grid grid-cols-3 gap-px overflow-hidden rounded-lg border border-line bg-line">
              {
                [
                  ['24/7', 'coverage'],
                  ['<2s', 'first reply'],
                  ['100%', 'logged'],
                ].map(([value, label]) => (
                  <div class="bg-panel-2 px-3 py-3 text-center">
                    <p class="font-mono text-sm text-accent">{value}</p>
                    <p class="mt-0.5 text-[10px] tracking-wide text-muted uppercase">{label}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <p class="mt-3 px-1 font-mono text-[11px] text-muted/70">
          Laravel webhook · queue workers · LLM tool calls · MySQL audit log
        </p>
      </div>
    </div>
  </div>
</section>
