---
import { Image } from 'astro:assets';
import reyan from '../assets/reyan.png';
import { site } from '../config';

/**
 * `base` keeps the in-page anchors working off the homepage. Pass "/" on
 * sub-pages so "#work" becomes "/#work" instead of a dead anchor.
 */
interface Props {
  base?: string;
}

const { base = '' } = Astro.props;

const links = [
  { href: '#work', label: 'Work' },
  { href: '#services', label: 'Services' },
  { href: '#process', label: 'Process' },
  { href: '#faq', label: 'FAQ' },
];
---

<header
  class="sticky top-0 z-50 border-b border-line/70 bg-ink/80 backdrop-blur-md supports-[backdrop-filter]:bg-ink/70"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-6">
    <a href={`${base}#top`} class="group flex items-center gap-3" aria-label={`${site.name} — home`}>
      <Image
        src={reyan}
        alt={`Portrait of ${site.name}`}
        width={72}
        height={72}
        format="webp"
        quality={80}
        loading="eager"
        fetchpriority="high"
        class="size-9 rounded-lg object-cover ring-1 ring-line transition group-hover:ring-accent/50"
      />
      <span class="flex flex-col leading-none">
        <span class="text-sm font-semibold tracking-tight">{site.name}</span>
        <span class="mt-1 font-mono text-[10px] tracking-wide text-muted uppercase">
          AI-native product engineer
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={`${base}${link.href}`}
            class="rounded-lg px-3 py-2 text-sm text-muted transition hover:bg-panel hover:text-fg"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={site.resume}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-lg border border-line px-3 py-2 text-sm text-muted transition hover:border-accent/40 hover:text-fg lg:inline-block"
      >
        Résumé
      </a>

      <a
        href={site.booking.url}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-accent-ink transition hover:brightness-95 sm:inline-block"
      >
        {site.booking.label}
      </a>

      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation"
        class="grid size-10 place-items-center rounded-lg border border-line text-fg transition hover:bg-panel md:hidden"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" data-nav-menu class="hidden border-t border-line/70 bg-ink md:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col px-6 py-3" aria-label="Mobile">
      {
        links.map((link) => (
          <a
            href={`${base}${link.href}`}
            class="border-b border-line/50 py-3 text-sm text-muted transition hover:text-fg last:border-0"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={site.resume}
        target="_blank"
        rel="noopener noreferrer"
        class="border-b border-line/50 py-3 text-sm text-muted transition last:border-0 hover:text-fg"
      >
        Résumé
      </a>
      <a
        href={site.booking.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 rounded-lg bg-accent px-4 py-3 text-center text-sm font-semibold text-accent-ink"
      >
        {site.booking.label}
      </a>
    </nav>
  </div>
</header>
