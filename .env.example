[TEMPLATE]
# ── Email delivery ──────────────────────────────────────────────────────────
# The contact form and the demo's booking flow both send through src/lib/mail.ts.
# It uses SMTP when SMTP_USER + SMTP_PASS are set, otherwise Resend.
#
# Option A (recommended): Gmail / Google Workspace SMTP.
#   1. Turn on 2-Step Verification for the Google account.
#   2. Open https://myaccount.google.com/apppasswords and create one named
#      "Portfolio site". Copy the 16-character password.
#   3. Paste it below. Spaces are fine — they are stripped before use.
#
# Your normal Gmail password will NOT work: Google removed "less secure app"
# access, so an App Password is the only way in. Port 587 (STARTTLS) works from
# Vercel; port 25 is blocked there.
SMTP_USER=reyanshoaib45@gmail.com
SMTP_PASS=

# Defaults to smtp.gmail.com:587. Only set these for Workspace or another host.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Option B (automatic fallback if SMTP_* is empty): Resend — https://resend.com
# RESEND_API_KEY=

# Where enquiries and demo bookings land. Defaults to reyanshoaib45@gmail.com.
CONTACT_TO_EMAIL=reyanshoaib45@gmail.com

# From address. Gmail only allows sending as the authenticated account (or a
# verified Workspace alias), so leave this empty and it follows SMTP_USER.
# CONTACT_FROM_EMAIL=Portfolio <hello@reyanshoaib.com>
